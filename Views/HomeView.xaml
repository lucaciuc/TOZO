<UserControl x:Class="TozoWindowsApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="420"
             Background="#222327">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Grid Margin="16,24,16,16">
        <StackPanel>
            
            <!-- Header Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NC20 Pro" FontSize="26" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Ellipse Width="12" Height="12" Fill="#4CAF50" Margin="10,0,0,0" VerticalAlignment="Center" Stroke="#222327" StrokeThickness="2"
                             Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                
                <Button Grid.Column="1" Command="{Binding ConnectCommand}" 
                        Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Content="Connect" Width="100" Height="40" VerticalAlignment="Center" Foreground="White" BorderBrush="White"/>
                        
                <Button Grid.Column="1" Command="{Binding OpenBoxCommand}" Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                        Background="#33353A" BorderThickness="0" Width="48" Height="48">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="PackageVariantClosed" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Box" FontSize="11" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Location Status (Placeholder) -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,16">
                <materialDesign:PackIcon Kind="NavigationVariant" Foreground="#4A90E2" VerticalAlignment="Center" Width="18" Height="18"/>
                <TextBlock Text="Location settings are off" Foreground="#888888" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Battery Row -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                <!-- Left -->
                <TextBlock Text="L" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LeftBatteryText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,12,0"/>
                <ProgressBar Value="{Binding LeftBattery}" Visibility="{Binding IsLeftBatteryKnown, Converter={StaticResource BoolToVis}}" Minimum="0" Maximum="100" Height="4" Width="40" VerticalAlignment="Center" Foreground="White" Background="#444444"/>
                
                <!-- Right -->
                <TextBlock Text="R" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="32,0,0,0"/>
                <TextBlock Text="{Binding RightBatteryText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,12,0"/>
                <ProgressBar Value="{Binding RightBattery}" Visibility="{Binding IsRightBatteryKnown, Converter={StaticResource BoolToVis}}" Minimum="0" Maximum="100" Height="4" Width="40" VerticalAlignment="Center" Foreground="White" Background="#444444"/>
            </StackPanel>

            <!-- Connection Log Expander -->
            <Expander Header="Connection Log" Margin="0,8,0,0" Foreground="#888888">
                <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding ConnectionStatus, Mode=OneWay}" 
                             Foreground="#888888"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             TextWrapping="Wrap"/>
                </ScrollViewer>
            </Expander>

            <!-- Central Earbuds Image Placeholder -->
            <Grid Height="220" Margin="0,24,0,24">
                <materialDesign:PackIcon Kind="Earbuds" Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#444444"/>
            </Grid>

            <!-- Circular Controls Row -->
            <UniformGrid Columns="3" Margin="0,0,0,24" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                
                <!-- Eartune -->
                <StackPanel>
                    <Button Command="{Binding OpenEartuneCommand}" Style="{StaticResource MaterialDesignFloatingActionLightButton}" Width="65" Height="65" Background="#2C2F36" BorderThickness="0">
                        <materialDesign:PackIcon Kind="EarHearing" Width="32" Height="32" Foreground="#D0D0D0"/>
                    </Button>
                    <TextBlock Text="Eartune" FontSize="13" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- ANC -->
                <StackPanel>
                    <Button Command="{Binding OpenAncCommand}" Style="{StaticResource MaterialDesignFloatingActionLightButton}" Width="65" Height="65" Background="#2C2F36" BorderThickness="0">
                        <materialDesign:PackIcon Kind="VolumeOff" Width="32" Height="32" Foreground="#D0D0D0"/>
                    </Button>
                    <TextBlock Text="ANC" FontSize="13" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Settings -->
                <StackPanel>
                    <Button Style="{StaticResource MaterialDesignFloatingActionLightButton}" Width="65" Height="65" Background="#2C2F36" BorderThickness="0">
                        <materialDesign:PackIcon Kind="Cog" Width="32" Height="32" Foreground="#D0D0D0"/>
                    </Button>
                    <TextBlock Text="Settings" FontSize="13" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </UniformGrid>

            <!-- EQ Gradient Card -->
            <materialDesign:Card Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" 
                                 UniformCornerRadius="16" Height="150" Padding="20">
                <materialDesign:Card.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6C5CE7" Offset="0.0" />
                        <GradientStop Color="#A29BFE" Offset="1.0" />
                    </LinearGradientBrush>
                </materialDesign:Card.Background>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Sound effect" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Grid.Row="1" Text="Current Use EQ:Bass +" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,0"/>

                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Content="EQ Zone" Background="White" Foreground="Black" FontWeight="Bold" BorderThickness="0" Margin="0,0,4,0" Height="36" Style="{StaticResource MaterialDesignFlatButton}"/>
                        <Button Grid.Column="1" Content="Advanced EQ" Background="White" Foreground="Black" FontWeight="Bold" BorderThickness="0" Margin="4,0,4,0" Height="36" Style="{StaticResource MaterialDesignFlatButton}"/>
                        <Button Grid.Column="2" Content="Sound effects" Background="White" Foreground="Black" FontWeight="Bold" BorderThickness="0" Margin="4,0,0,0" Height="36" Style="{StaticResource MaterialDesignFlatButton}"/>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </StackPanel>
    </Grid>
</UserControl>
